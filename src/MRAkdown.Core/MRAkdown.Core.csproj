<Project Sdk="Microsoft.NET.Sdk">

  <!-- Everything that doesn't depend on the window system: note indexing, rendering, and serving the page. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>MRAkdown.Core</AssemblyName>
    <RootNamespace>MRAkdown</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <EmbeddedResource Include="..\..\web\**" LogicalName="web/%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="MRAkdown" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Markdig" Version="1.4.1" />
  </ItemGroup>

</Project>
